{
  "name": "@codereview/cli",
  "version": "1.0.0",
  "description": "CLI tool for local code review with AI assistance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codereview": "./bin/codereview"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "dev": "bun run src/index.ts",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "commander": "^12.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": ["cli", "code review", "github", "pr", "ai"],
  "author": "thongvl",
  "license": "MIT"
}
